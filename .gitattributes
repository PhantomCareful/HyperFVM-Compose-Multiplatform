# 换行统一：仓库内存 LF，Windows 检出按规则转换（core.autocrlf=true）
* text=auto

# Gradle wrapper 的 sh 脚本必须保持 LF，否则在 Linux/macOS 上无法执行
gradlew text eol=lf
gradlew.bat text eol=crlf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制：不做换行转换与 diff
*.ico binary
*.webp binary
*.png binary
*.jar binary
*.apk binary
*.zip binary
